{
  "name": "@industrial/database",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "db:generate": "typeorm migration:generate -d src/data-source.ts",
    "db:migrate": "typeorm migration:run -d src/data-source.ts",
    "db:revert": "typeorm migration:revert -d src/data-source.ts"
  },
  "dependencies": {
    "typeorm": "^0.3.20",
    "reflect-metadata": "^0.2.0",
    "mysql2": "^3.6.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}